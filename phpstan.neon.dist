# Recommended PHPStan / Larastan baseline for projects using jpswade/laravel-best-practices.
#
# RFC practices this config enforces:
#   - consistent return types          (Larastan level 6+)
#   - no bare \Exception catches       (phpstan-strict-rules: tooWideThrowType, missingCheckedExceptionInThrows)
#   - strict comparisons               (phpstan-strict-rules: defence-in-depth alongside Pint's strict_comparison)
#
# Level 6 is a workable starting point on existing codebases.
# Bump to level 8 once the codebase is clean; level 9 is the strict ideal.
#
# Optional opt-in for the "default-to-private visibility" practice:
#   composer require --dev tomasvotruba/unused-public
# Then add `- vendor/tomasvotruba/unused-public/config/extension.neon` to `includes`.
# It is not in this baseline because adopting it cleanly often requires refactoring.

includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon

parameters:
    level: 6
    paths:
        - app
        - tests
    checkMissingIterableValueType: true
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        # Eloquent forwards `Model::where(...)`, `Model::query()` etc. through
        # `__callStatic` to a freshly-built Builder. PHPStan correctly resolves
        # the receiver to `Illuminate\Database\Eloquent\Builder<X>` and then
        # flags the call as "dynamic, not static". This is the documented Laravel
        # idiom, not a bug, and routinely buries hundreds of baseline entries
        # in any non-trivial Eloquent codebase. The rule still fires on every
        # non-Eloquent class. See DECISIONS.md ("PHPStan: allow dynamic calls
        # on Eloquent Builder<*>") for the trade-off.
        -
            identifier: staticMethod.dynamicCall
            message: '#^Dynamic call to static method Illuminate\\Database\\Eloquent\\Builder\<.+\>\:\:.+\(\)\.$#'
    exceptions:
        check:
            missingCheckedExceptionInThrows: true
            tooWideThrowType: true
        implicitThrows: false
        uncheckedExceptionClasses:
            - LogicException
            - RuntimeException
            # Infrastructure exceptions that surface as static-analysis noise
            # across the codebase. PHPUnit's MockObject throws on every prophecy;
            # PSR-16 (Laravel Cache) and the DI container declare these on their
            # interfaces and user code never realistically catches them. Treating
            # them as unchecked avoids decorating every helper, test and
            # controller with @throws. Production-relevant exceptions
            # (ValidationException, RequestException, JsonException, etc.) are
            # deliberately NOT on this list and still require @throws.
            # See DECISIONS.md ("Treat infrastructure exceptions as unchecked").
            - PHPUnit\Framework\MockObject\Exception
            - Psr\SimpleCache\InvalidArgumentException
            - Illuminate\Contracts\Container\BindingResolutionException
            - ReflectionException
